{
  "name": "LighthouseReckoning",
  "version": "1.1.0",
  "description": "Lightweight LoRa mesh networking with automatic multi-hop routing toward a Home node, neighbor discovery, and hop-by-hop delivery acknowledgments.",
  "keywords": [
    "lora",
    "mesh",
    "routing",
    "radiolib",
    "wireless",
    "sx1262",
    "iot"
  ],
  "authors": [
    {
      "name": "Fynn Jannis Schulz",
      "email": "fynnsscp009@gmail.com",
      "maintainer": true
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TidalImpact/LighthouseReckoning.git"
  },
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": [
    "espressif32",
    "raspberrypi"
  ],
  "dependencies": {
    "jgromes/RadioLib": "^6.0.0"
  },
  "headers": "LighthouseReckoning.h",
  "export": {
    "include": [
      "LighthouseReckoning.h",
      "LighthouseReckoning.cpp",
      "LHR_TypeDef.h",
      "LHR_Packet.h",
      "LHR_Routing.h",
      "LHR_Routing.cpp",
      "LHR_Rx.h",
      "LHR_Rx.cpp",
      "LHR_Tx.h",
      "LHR_Tx.cpp",
      "LHR_DutyCycle.h",
      "LHR_DutyCycle.cpp",
      "examples",
      "keywords.txt",
      "library.properties",
      "LICENSE"
    ],
    "exclude": [
      "examples/**/build/**"
    ] 
  }
}